# MasteryLoop Environment Configuration
PROJECT_NAME="MasteryLoop"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT
SECRET_KEY="masteryloop-secret-key-change-in-production-only"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/masteryloop
# For SQLite (default development fallback): sqlite:///./masteryloop.db
DATABASE_URL="sqlite:///./masteryloop.db"

# Vector Store (Qdrant)
# For in-memory development: QDRANT_URL=":memory:"
# For local persistent disk: QDRANT_PATH="./data/qdrant"
# For remote cluster: QDRANT_URL="https://your-cluster.qdrant.tech", QDRANT_API_KEY="your-key"
QDRANT_URL=":memory:"
QDRANT_PATH=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="masteryloop_curriculum"

# Embedding Providers ("hashed" bag-of-words by default, "sentence-transformers", "openai")
EMBEDDING_PROVIDER="hashed"
SENTENCE_TRANSFORMER_MODEL="paraphrase-multilingual-MiniLM-L12-v2"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# LLM Providers ("mock", "openai", "gemini")
# Deterministic pedagogic fallback active when keys are absent
OPENAI_API_KEY=""
GEMINI_API_KEY=""
LLM_PROVIDER="mock"

# Assessment & Psychometrics Settings
DEFAULT_TARGET_SE=0.30
MAX_ADAPTIVE_QUESTIONS=15
MIN_ADAPTIVE_QUESTIONS=5
PILOT_MIX_PROBABILITY=0.15
EXPOSURE_CONTROL_CAP=50
